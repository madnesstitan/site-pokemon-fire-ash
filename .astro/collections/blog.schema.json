{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "minLength": 20,
      "maxLength": 72
    },
    "description": {
      "type": "string",
      "minLength": 80,
      "maxLength": 170
    },
    "pubDate": {
      "type": "string",
      "format": "date-time"
    },
    "updatedDate": {
      "type": "string",
      "format": "date-time"
    },
    "pageType": {
      "type": "string",
      "enum": [
        "home",
        "pillar",
        "blog",
        "comparison",
        "how_to",
        "legal"
      ]
    },
    "heroImage": {
      "type": "string"
    },
    "keywords": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "$schema": {
      "type": "string"
    }
  },
  "required": [
    "title",
    "description",
    "pubDate",
    "pageType"
  ]
}