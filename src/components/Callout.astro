---
/**
 * <Callout> — a tinted box for emphasis. Use sparingly to break up long prose.
 *
 *   <Callout type="tip" title="Shortcut">You can skip step 2.</Callout>
 *
 * `type` tints the left border + icon. Default `info`. No JS.
 */
interface Props {
  type?: 'info' | 'tip' | 'warn' | 'success' | 'danger';
  title?: string;
}
const { type = 'info', title } = Astro.props;

const label: Record<Props['type'] & string, string> = {
  info: 'Note',
  tip: 'Tip',
  warn: 'Heads up',
  success: 'Done',
  danger: 'Warning',
};

// Vanguard callout colors — map the semantic type to a palette fill. The
// .callout-box.<color> classes live in global.css and use the card tokens.
const colorClass: Record<Props['type'] & string, string> = {
  info: 'teal',
  tip: 'green',
  warn: 'yellow',
  success: 'green',
  danger: 'burgundy',
};
---

<aside class:list={['callout-box my-6', colorClass[type]]}>
  <div class="dashed-badge">{title ?? label[type]}</div>
  <div class="text-[0.95rem] leading-relaxed">
    <slot />
  </div>
</aside>