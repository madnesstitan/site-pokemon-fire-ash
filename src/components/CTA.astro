---
/**
 * <CTA> — a call-to-action band. One primary link, optional secondary link.
 *
 *   <CTA title="Ready to play?" text="Grab the top ROM hack today."
 *        href="/best" label="See the list" />
 *
 * Also usable inline (rendered as a button group) when placed inside <Hero>.
 */
interface Link {
  href: string;
  label: string;
}
interface Props {
  title: string;
  text?: string;
  href?: string;
  label?: string;
  secondary?: Link;
  variant?: 'band' | 'inline';
}
const {
  title,
  text,
  href,
  label,
  secondary,
  variant = 'band',
} = Astro.props;
const isBand = variant === 'band';
---

{
  isBand ? (
    <section class="vcard gradient my-12 items-center text-center">
      <h2 class="text-2xl font-extrabold sm:text-3xl">{title}</h2>
      {text && <p class="mx-auto mt-2 max-w-xl" style="opacity: 0.95;">{text}</p>}
      {(href && label) || secondary ? (
        <div class="mt-6 flex flex-wrap justify-center gap-3">
          {href && label && <a href={href} class="btn-primary">{label}</a>}
          {secondary && <a href={secondary.href} class="btn-secondary">{secondary.label}</a>}
        </div>
      ) : null}
    </section>
  ) : (
    <div class="flex flex-wrap gap-3">
      {href && label && <a href={href} class="btn-primary">{label}</a>}
      {secondary && <a href={secondary.href} class="btn-secondary">{secondary.label}</a>}
    </div>
  )
}