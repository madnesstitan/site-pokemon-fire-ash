---
/**
 * <CTA> — a call-to-action band. One primary link, optional secondary link.
 *
 *   <CTA title="Ready to play?" text="Grab the top ROM hack today."
 *        href="/best" label="See the list" />
 *
 * Also usable inline (rendered as a button group) when placed inside <Hero>.
 */
interface Link {
  href: string;
  label: string;
}
interface Props {
  title: string;
  text?: string;
  href?: string;
  label?: string;
  secondary?: Link;
  variant?: 'band' | 'inline';
}
const {
  title,
  text,
  href,
  label,
  secondary,
  variant = 'band',
} = Astro.props;
const isBand = variant === 'band';
---

{
  isBand ? (
    <section class="my-12 rounded-md border border-border bg-surface p-6 text-center shadow-sm sm:p-8">
      <h2 class="text-2xl font-bold sm:text-3xl">{title}</h2>
      {text && <p class="mx-auto mt-2 max-w-xl text-muted">{text}</p>}
      {(href && label) || secondary ? (
        <div class="mt-6 flex flex-wrap justify-center gap-3">
          {href && label && (
            <a
              href={href}
              class="inline-flex items-center rounded-sm bg-accent px-6 py-3 font-semibold text-on-accent shadow-md transition hover:brightness-110"
            >
              {label}
            </a>
          )}
          {secondary && (
            <a
              href={secondary.href}
              class="inline-flex items-center rounded-sm border border-border px-6 py-3 font-semibold text-text transition hover:bg-surface-2"
            >
              {secondary.label}
            </a>
          )}
        </div>
      ) : null}
    </section>
  ) : (
    <div class="flex flex-wrap gap-3">
      {href && label && (
        <a
          href={href}
          class="inline-flex items-center rounded-sm bg-accent px-6 py-3 font-semibold text-on-accent shadow-md transition hover:brightness-110"
        >
          {label}
        </a>
      )}
      {secondary && (
        <a
          href={secondary.href}
          class="inline-flex items-center rounded-sm border border-border px-6 py-3 font-semibold text-text transition hover:bg-surface-2"
        >
          {secondary.label}
        </a>
      )}
    </div>
  )
}