---
/**
 * <FeatureGrid> — a responsive card grid. AI authors pass an `items` array;
 * that's far more reliable than asking an LLM to nest JSX children.
 *
 *   <FeatureGrid items={[
 *     { title: "Fast", text: "Builds in 60s." },
 *     { title: "Cheap", text: "Under $3 a site." },
 *     { title: "No lock-in", text: "Git is the content store." }
 *   ]} />
 *
 * `columns` is optional; defaults to the item count capped at 4. Cards link
 * out when `href` is present (common pattern: feature → pillar page).
 */
interface Item {
  title: string;
  text: string;
  href?: string;
}
interface Props {
  items?: Item[];
  columns?: number;
}
// ponytail: ``?? []`` guard — see Steps.astro for rationale (wrong prop
// name from the LLM → undefined ``items`` → empty render, not a build crash).
const { items = [], columns } = Astro.props;
const cols = Math.min(Math.max(columns ?? items.length, 1), 4);

const spanClass: Record<number, string> = {
  1: 'sm:grid-cols-1',
  2: 'sm:grid-cols-2',
  3: 'sm:grid-cols-3',
  4: 'sm:grid-cols-4',
};
---

<div class={`my-10 grid grid-cols-1 gap-6 ${spanClass[cols]}`}>
  {
    items.map((it, i) => {
      const Card = (
        <div class={`vcard card-${(i % 6) + 1} h-full`}>
          <h3 class="text-lg font-bold">{it.title}</h3>
          <p class="text-sm leading-relaxed" style="opacity: 0.93;">
            {it.text}
          </p>
        </div>
      );
      return it.href ? (
        <a href={it.href} class="block h-full no-underline">
          {Card}
        </a>
      ) : (
        Card
      );
    })
  }
</div>