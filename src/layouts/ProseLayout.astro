---
/**
 * ProseLayout — wraps BaseLayout with the content scaffold.
 *
 * Two modes:
 *   - kind="article" (blog posts): renders an <h1> + byline + hero image
 *     banner, then the MDX body in <article class="prose">. The writer must
 *     NOT also write an <h1> or a <Hero> at the top.
 *   - kind="landing" (home/pillar/comparison/how_to): renders the MDX body
 *     only, in <article class="prose">. The page leads with its own <Hero>
 *     or an <h1> (exactly one — enforced by the writing skill, not here).
 *
 * This single rule (the writer controls the lead, the layout controls the
 * shell) avoids duplicate <h1>s without a fragile "detect Hero in the body".
 */
import BaseLayout from './BaseLayout.astro';
import { site } from '../../site.config';
import type { PageFrontmatter, PageType } from '../content.config';

interface Props {
  frontmatter: PageFrontmatter;
  pageType: PageType;
  path: string;
  kind: 'article' | 'landing';
}

const { frontmatter, pageType, path, kind } = Astro.props;
const isArticle = kind === 'article';
const isLegal = pageType === 'legal';
const fmtDate = (d: Date) =>
  d.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
---

<BaseLayout
  title={frontmatter.title}
  description={frontmatter.description}
  pageType={pageType}
  path={path}
  pubDate={frontmatter.pubDate}
  updatedDate={frontmatter.updatedDate}
  heroImage={frontmatter.heroImage}
  keywords={frontmatter.keywords}
>
  {isArticle ? (
    <article class="mx-auto max-w-3xl px-6 py-12 sm:py-16">
      <header class="mb-8 flex flex-col gap-4">
        <a href="/blog" class="text-sm font-bold text-accent no-underline">
          ← Back to Blog
        </a>
        <h1 class="text-4xl font-extrabold leading-tight tracking-tight sm:text-5xl">
          {frontmatter.title}
        </h1>
        <div class="flex flex-wrap items-center gap-3 border-b border-border pb-6 text-sm font-semibold text-muted">
          <span class="flex items-center gap-2 text-text">
            <span>Written by {site.name}</span>
          </span>
          <span aria-hidden="true">•</span>
          <time datetime={new Date(frontmatter.pubDate).toISOString()}>
            {fmtDate(frontmatter.pubDate)}
          </time>
          {frontmatter.updatedDate && (
            <>
              <span aria-hidden="true">•</span>
              <span>updated {fmtDate(frontmatter.updatedDate)}</span>
            </>
          )}
        </div>
      </header>

      {frontmatter.heroImage && (
        <div class="article-hero-card mb-8">
          <img src={frontmatter.heroImage} alt="" loading="eager" />
        </div>
      )}

      <div class="prose">
        <slot />
      </div>

      <div class="author-box">
        <div>
          <div class="author-name">{site.name}</div>
          <div class="author-bio">{site.tagline}</div>
        </div>
      </div>
    </article>
  ) : isLegal ? (
    <div class="mx-auto max-w-3xl px-6 py-14 sm:py-20">
      <main class="policy-card">
        <header class="flex flex-col gap-2 border-b border-border pb-6">
          <h1 class="text-4xl font-extrabold tracking-tight">{frontmatter.title}</h1>
          <div class="text-sm font-semibold text-muted">
            Last Updated: {fmtDate(frontmatter.updatedDate ?? frontmatter.pubDate)}
          </div>
        </header>
        <div class="prose">
          <slot />
        </div>
      </main>
    </div>
  ) : (
    <article class="mx-auto max-w-3xl px-6 py-12 sm:py-16">
      <div class="prose">
        <slot />
      </div>
    </article>
  )}
</BaseLayout>