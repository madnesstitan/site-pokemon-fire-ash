---
/**
 * BaseLayout — the HTML shell + deterministic SEO.
 *
 * Everything SEO lives here, generated from frontmatter (no LLM writes meta):
 *   <title>, description, canonical, Open Graph, Twitter card, and JSON-LD.
 *
 * JSON-LD selection is driven by pageType + path:
 *   - home          → WebSite (+ PotentialSearchAction)
 *   - any content   → Article/BreadcrumbList (blog uses BlogPosting)
 *
 * Theme + accent are applied to <html> via data-theme + an inline
 * --color-accent override, so site.config.ts is the *only* place design lives.
 */
import { type CollectionEntry, getCollection } from 'astro:content';
import { site, siteUrl } from '../../site.config';
import type { PageType } from '../content.config';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  pageType: PageType;
  path: string; // route path, e.g. "/" or "/blog/foo" — drives canonical + breadcrumb
  pubDate?: Date | undefined;
  updatedDate?: Date | undefined;
  heroImage?: string | undefined;
  keywords?: string[] | undefined;
}

const {
  title,
  description,
  pageType,
  path,
  pubDate,
  updatedDate,
  heroImage,
  keywords = [],
} = Astro.props;

const canonical = new URL(path, siteUrl).href;
const ogImage = heroImage ? new URL(heroImage, siteUrl).href : undefined;
const isHome = path === '/';
const isBlogIndex = path === '/blog';
const fullTitle = isHome || isBlogIndex ? title : `${title} — ${site.name}`;

// Nav: top non-home pages, freshest first, capped. Blog gets a fixed slot.
let navPages: CollectionEntry<'pages'>[] = [];
try {
  const all = await getCollection('pages');
  navPages = all
    .filter((p) => p.data.pageType !== 'home')
    .sort((a, b) => +new Date(b.data.pubDate) - +new Date(a.data.pubDate))
    .slice(0, 5);
} catch {
  // Layout may render during `astro check` before content is typed; fall back
  // to an empty nav rather than crashing the shell.
}

const dateIso = (d?: Date) => (d ? new Date(d).toISOString() : undefined);
const datePublished = dateIso(pubDate);
const dateModified = dateIso(updatedDate) ?? datePublished;

// Blog index needs the post list for its ItemList schema; only fetch then.
let blogIndexPosts: CollectionEntry<'blog'>[] = [];
if (isBlogIndex) {
  blogIndexPosts = (await getCollection('blog')).sort(
    (a, b) => +new Date(b.data.pubDate) - +new Date(a.data.pubDate),
  );
}

// --- JSON-LD -------------------------------------------------------------
// Three shapes, picked by page kind:
//   home        → WebSite (+ PotentialSearchAction)
//   /blog index → CollectionPage with an ItemList of posts
//   content     → BlogPosting (blog) / Article (everything else) + Breadcrumb
const websiteLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: site.name,
  url: siteUrl,
  description: site.tagline ?? description,
  potentialAction: {
    '@type': 'SearchAction',
    target: `${siteUrl}/?q={search_term_string}`,
    'query-input': 'required name=search_term_string',
  },
};

const collectionLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: title,
  url: canonical,
  isPartOf: { '@type': 'WebSite', name: site.name, url: siteUrl },
  mainEntity: {
    '@type': 'ItemList',
    itemListElement: blogIndexPosts.map((p, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      url: new URL(`/blog/${p.id}`, siteUrl).href,
      name: p.data.title,
    })),
  },
};

const breadcrumbLd = (crumbs: { name: string; path: string }[]) => ({
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: crumbs.map((c, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: c.name,
    item: new URL(c.path, siteUrl).href,
  })),
});

// A blog POST (path !== /blog) vs a pillar/comparison/how_to page both get an
// Article; only the @type differs. The blog index does not.
const isBlogPost = pageType === 'blog' && !isBlogIndex;
const articleLd = {
  '@context': 'https://schema.org',
  '@type': isBlogPost ? 'BlogPosting' : 'Article',
  headline: title,
  description,
  image: ogImage,
  datePublished,
  dateModified,
  author: { '@type': 'Organization', name: site.name },
  publisher: { '@type': 'Organization', name: site.name },
  mainEntityOfPage: { '@type': 'WebPage', '@id': canonical },
  keywords: keywords.join(', ') || undefined,
};

const crumbs =
  pageType === 'blog'
    ? isBlogIndex
      ? [{ name: 'Home', path: '/' }, { name: 'Blog', path: '/blog' }]
      : [{ name: 'Home', path: '/' }, { name: 'Blog', path: '/blog' }, { name: title, path }]
    : [{ name: 'Home', path: '/' }, { name: title, path }];

// Emit Article + Breadcrumb only on content pages (not home, not blog index).
const articleMode = !isHome && !isBlogIndex;
---

<!doctype html>
<html lang="en" data-theme={site.theme} style={`--color-accent: ${site.accent};`}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {
      keywords.length > 0 && <meta name="keywords" content={keywords.join(', ')} />
    }
    <link rel="canonical" href={canonical} />
    <meta name="generator" content={Astro.generator} />

    <!-- Open Graph -->
    <meta property="og:type" content={isBlogPost ? 'article' : 'website'} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    {
      articleMode && datePublished && (
        <meta property="article:published_time" content={datePublished} />
      )
    }
    {
      articleMode && dateModified && (
        <meta property="article:modified_time" content={dateModified} />
      )
    }

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- RSS / sitemap are emitted by integrations -->
    <link rel="sitemap" href="/sitemap-index.xml" />

    {
      isHome ? (
        <script type="application/ld+json" is:inline set:html={JSON.stringify(websiteLd)} />
      ) : isBlogIndex ? (
        <>
          <script type="application/ld+json" is:inline set:html={JSON.stringify(collectionLd)} />
          <script type="application/ld+json" is:inline set:html={JSON.stringify(breadcrumbLd(crumbs))} />
        </>
      ) : (
        <>
          <script type="application/ld+json" is:inline set:html={JSON.stringify(articleLd)} />
          <script type="application/ld+json" is:inline set:html={JSON.stringify(breadcrumbLd(crumbs))} />
        </>
      )
    }
  </head>
  <body class="flex min-h-screen flex-col">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:left-3 focus:top-3 focus:z-50 focus:rounded-sm focus:bg-accent focus:px-3 focus:py-1.5 focus:font-semibold focus:text-on-accent"
      >Skip to content</a
    >

    <header class="site-header">
      <div class="nav-container">
        <a href="/" class="brand-logo">{site.name}</a>
        <nav class="nav-links" aria-label="Primary">
          <a href="/" class="nav-link" aria-current={isHome ? 'page' : undefined}>Home</a>
          <a href="/blog" class="nav-link" aria-current={isBlogIndex ? 'page' : undefined}>Blog</a>
          {
            navPages.map((p) => {
              const href = `/${p.id}`;
              return (
                <a
                  href={href}
                  class="nav-link"
                  aria-current={path === href ? 'page' : undefined}
                >
                  {p.data.title.length > 24 ? p.data.title.slice(0, 23) + '…' : p.data.title}
                </a>
              );
            })
          }
        </nav>
      </div>
    </header>

    <main id="main" class="flex-1">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="footer-content">
        <p><strong>{site.name}</strong></p>
        <p>&copy; {new Date().getFullYear()} {site.name}.</p>
      </div>
    </footer>
  </body>
</html>