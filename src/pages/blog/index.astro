---
// Blog index at /blog — the mockup's colored-card grid. A gradient featured
// card (when the freshest post has a hero image) leads, then a grid of
// palette-cycling colored cards. Uses BaseLayout directly (not a prose page);
// BaseLayout emits a CollectionPage + BreadcrumbList schema for this path.
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { site } from '../../../site.config';

const posts = (await getCollection('blog')).sort(
  (a, b) => +new Date(b.data.pubDate) - +new Date(a.data.pubDate),
);

const fmt = (d: Date) =>
  d.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' });

// Split a featured (image-backed) post off the top; the rest fill the grid.
const [featured, ...rest] = posts;
const hasFeatured = Boolean(featured && featured.data.heroImage);
const gridPosts = hasFeatured ? rest : posts;

// Cycle the 6-color card palette; first keyword (or "Article") becomes the tag.
const cardClass = (i: number) => `card-${(i % 6) + 1}`;
const tag = (p: (typeof posts)[number]) => p.data.keywords?.[0] ?? 'Article';
---

<BaseLayout
  title={`Blog — ${site.name}`}
  description={`Articles from ${site.name}.`}
  pageType="blog"
  path="/blog"
>
  <main class="mx-auto max-w-5xl px-6 py-12 sm:py-16">
    <header class="mb-10 flex flex-col items-center gap-3 text-center">
      <h1 class="text-5xl font-extrabold tracking-tight">
        <span class="text-gradient-1">Blog</span>
      </h1>
      <p class="max-w-xl text-muted">
        {posts.length} article{posts.length === 1 ? '' : 's'} from {site.name}
      </p>
    </header>

    {hasFeatured && featured && (
      <a
        href={`/blog/${featured.id}`}
        class="featured-post-card mb-10"
      >
        <div class="flex flex-col">
          <span class="featured-tag">Featured</span>
          <h2>{featured.data.title}</h2>
          <p>{featured.data.description}</p>
          <span class="mt-4 text-sm font-bold" style="text-decoration: underline;">
            Read article →
          </span>
        </div>
        <img
          src={featured.data.heroImage}
          alt=""
          class="featured-thumb"
          loading="eager"
        />
      </a>
    )}

    <section class="blog-grid">
      {gridPosts.map((p, i) => (
        <a href={`/blog/${p.id}`} class={`blog-card ${cardClass(i)}`}>
          <div class="card-body">
            <span class="badge-tag">{tag(p)}</span>
            <h2 class="card-post-title">{p.data.title}</h2>
            <div class="post-meta">
              <time datetime={new Date(p.data.pubDate).toISOString()}>
                {fmt(p.data.pubDate)}
              </time>
            </div>
            <p class="card-post-excerpt">{p.data.description}</p>
          </div>
          <span class="btn-read-more">Read →</span>
        </a>
      ))}
    </section>
  </main>
</BaseLayout>